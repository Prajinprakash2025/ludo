# These are public addresses, not passwords. npm does not load this file automatically.
# Netlify build environment (rebuild the frontend when changing it):
BACKEND_URL=https://ludoloop.pythonanywhere.com

# Game server environment (replace this with your actual Netlify site):
ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
PUBLIC_URL=https://YOUR-SITE.netlify.app

# Local/combined hosting: leave BACKEND_URL and ALLOWED_ORIGINS unset.
# PythonAnywhere provides DOMAIN_SOCKET automatically; do not set a socket path here.
